using System.ComponentModel;
using System.Diagnostics;
using System.Runtime.InteropServices;
using Xunit;
using Xunit.Abstractions;

[assembly: CollectionBehavior(DisableTestParallelization = true, MaxParallelThreads = 1)]

public sealed class AdapterTests(ITestOutputHelper output)
{
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool GetProcessHandleCount(IntPtr process, out uint count);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern IntPtr CreateJobObject(IntPtr attributes, string? name);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool SetInformationJobObject(IntPtr job, int kind, ref uint flags, uint size);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);

    [Fact]
    public void ClosingLastJobHandleKillsOwnedProcess()
    {
        using var child = IdleChild();
        IntPtr job = IntPtr.Zero;
        try
        {
            job = StatechartJob.Attach(child.Id);
            Assert.NotEqual(IntPtr.Zero, job);
            Assert.False(child.HasExited);
            Assert.True(StatechartJob.CloseHandle(job));
            job = IntPtr.Zero;
            Assert.True(child.WaitForExit(5000), "KILL_ON_JOB_CLOSE did not terminate owned child");
            output.WriteLine($"Owned child {child.Id} exited after last job handle closed");
        }
        finally { Cleanup(child, job); }
    }

    [Fact]
    public void TerminationUsesRequestedExitCodeAndClosedHandleIsInvalid()
    {
        using var child = IdleChild();
        IntPtr job = IntPtr.Zero;
        try
        {
            job = StatechartJob.Attach(child.Id);
            Assert.True(StatechartJob.TerminateJobObject(job, 2));
            Assert.True(child.WaitForExit(5000), "TerminateJobObject did not terminate owned child");
            Assert.Equal(2, child.ExitCode);
            Assert.True(StatechartJob.CloseHandle(job));
            IntPtr closed = job;
            job = IntPtr.Zero;
            Assert.False(StatechartJob.TerminateJobObject(closed, 2));
            Assert.Equal(6, Marshal.GetLastWin32Error());
            output.WriteLine($"Owned child {child.Id} exit=2; closed job ERROR_INVALID_HANDLE=6");
        }
        finally { Cleanup(child, job); }
    }

    [Fact]
    public void InvalidPidThrowsAndClosesEveryAllocatedJob()
    {
        // PID zero is the Windows idle process and OpenProcess rejects it; no foreign handle opens.
        void Reject() => Assert.Equal(87, Assert.Throws<Win32Exception>(() => StatechartJob.Attach(0)).NativeErrorCode);
        Reject();
        AssertNoHandleLeak(Reject, "OpenProcess invalid PID, ERROR_INVALID_PARAMETER=87");
    }

    [Fact]
    public void NonNestableOwnedJobRejectsAssignmentAndClosesJobAndProcessHandles()
    {
        using var child = IdleChild();
        IntPtr outer = CreateJobObject(IntPtr.Zero, null);
        Assert.NotEqual(IntPtr.Zero, outer);
        try
        {
            // A job with UI restrictions cannot be nested. All handles and processes are ours.
            uint uiLimits = 1;
            Assert.True(SetInformationJobObject(outer, 4, ref uiLimits, sizeof(uint)));
            Assert.True(AssignProcessToJobObject(outer, child.Handle));
            void Reject() => Assert.Equal(5, Assert.Throws<Win32Exception>(() => StatechartJob.Attach(child.Id)).NativeErrorCode);
            Reject();
            AssertNoHandleLeak(Reject, "AssignProcessToJobObject non-nestable owned job, ERROR_ACCESS_DENIED=5");
            Assert.False(child.HasExited);
            Assert.True(StatechartJob.TerminateJobObject(outer, 7));
            Assert.True(child.WaitForExit(5000));
            Assert.Equal(7, child.ExitCode);
            output.WriteLine($"Owned non-nestable child {child.Id} remained alive after failed Attach, then exited=7");
        }
        finally { Cleanup(child, outer); }
    }

    private void AssertNoHandleLeak(Action failure, string scenario)
    {
        using var current = Process.GetCurrentProcess();
        Assert.True(GetProcessHandleCount(current.Handle, out uint before));
        for (int attempt = 0; attempt < 32; attempt++) failure();
        Assert.True(GetProcessHandleCount(current.Handle, out uint after));
        output.WriteLine($"{scenario}: 32 failures; handles before={before}, after={after}");
        // Allow at most three host-owned lazy handles; either leaked adapter handle adds 32.
        Assert.True(after <= before + 3, $"Native handle growth {before} -> {after}");
    }

    private static Process IdleChild()
    {
        var start = new ProcessStartInfo("powershell.exe")
        {
            UseShellExecute = false, CreateNoWindow = true,
            RedirectStandardInput = true, RedirectStandardOutput = true, RedirectStandardError = true
        };
        foreach (string argument in new[] { "-NoProfile", "-NonInteractive", "-Command", "[Console]::In.ReadToEnd() | Out-Null" })
            start.ArgumentList.Add(argument);
        return Process.Start(start) ?? throw new InvalidOperationException("Owned idle process did not start");
    }

    private static void Cleanup(Process child, IntPtr job)
    {
        if (job != IntPtr.Zero) Assert.True(StatechartJob.CloseHandle(job));
        if (!child.HasExited) child.Kill();
        Assert.True(child.WaitForExit(5000), "Owned process cleanup did not finish");
    }
}
