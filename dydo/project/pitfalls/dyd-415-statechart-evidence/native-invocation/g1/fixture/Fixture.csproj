<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildThisFileDirectory)../../../../../../../</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/StatechartProtocol.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsJobBasicLimits.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsJobIoCounters.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsJobLimits.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsJobPort.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsJobAccounting.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsStatechartNative.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsStatechartJob.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/WindowsStatechartCompletion.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/PosixStatechartArguments.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/PosixStatechartNative.cs" />
    <Compile Include="$(RepositoryRoot)/Services/Statechart/PosixStatechartProcess.cs" />
  </ItemGroup>
</Project>
